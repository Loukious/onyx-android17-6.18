+static int hvc_backend_flush(u32 key, bool wait)
+{
+	struct hvc_backend *backend;
+	int idx, ret = 0;
+
+	backend = hvc_backend_get(key, false, &idx);
+	if (!backend)
+		return -ENODEV;
+	if (backend->ops->flush)
+		ret = backend->ops->flush(backend->data, wait);
+	hvc_backend_put(backend, idx);
+	return ret;
