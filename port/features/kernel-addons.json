  "addons": {
    "bbrv3": {
      "repository": "https://github.com/WildKernels/GKI_KernelSU_SUSFS",
      "revision": "24f78ca1b24fd1be2ebaffd215464f0d292a4877",
      "upstream_patch": ".github/patches/bbrv3/bbrv3_6.18.patch",
      "license": "tcp_bbr3.c upstream Dual BSD/GPL; port selects GPL-2.0-only",
      "configuration": [
        "CONFIG_TCP_CONG_BBR3=y",
        "CONFIG_NET_SCH_FQ=y"
      ],
      "adaptations": [
        "Built-in bool for direct TCP hooks",
        "Reno fallback on private allocation failure, preserving module ownership",
        "Keep stock tcp_skb_cb layout and64-bit timestamps",
        "Private socket-owned state and RCU-safe diagnostic hash",
        "Identify BBR3 before reading shared congestion private bytes",
        "Preserve other congestion algorithms ECN callbacks without reused flags/bits",
        "Place TCP_BBR3_INFO in correct socket-option switch, lock socket and return telemetry length",
        "Mark TLP recovery only on confirmed loss recovery",
        "Read newest exact private transmit snapshot; safely skip missing per-packet bound"
      ],
      "limitations": [
        "6.18 lacks old shallow-ECN route flag; incompatible shallow-ECN opt-in is disabled, loss-based model remains active",
        "64-skb private snapshot ring may evict older packet samples; aggregate loss model remains active"
      ]
    },
    "baseband_guard": {
      "repository": "https://github.com/vc-teahouse/Baseband-guard",
      "revision": "028ff7fd509e2104596da7cc1ef8e6ce2a0c9082",
      "license": "GPL-2.0-only",
      "configuration": [
        "CONFIG_BBG=y",
        "CONFIG_SECURITY_SELINUX=y",
        "CONFIG_LSM must contain baseband_guard"
      ],
      "defaults": {
        "BBG_BLOCK_BOOT": false,
        "BBG_BLOCK_RECOVERY": false
      },
      "adaptations": [
        "Reproducible Kbuild, fixed source identity and locally generated SELinux class IDs",
        "Linux6.18 private block header and two-argument blkdev_get_no_open",
        "Handle missing block device safely",
        "Serialize allow-cache insertion and readers",
        "Permit both exact A/B suffixes when corresponding boot/recovery protection is disabled",
        "Retry late-installed root SELinux domains, never cache failure permanently",
        "Detect current su/ksu/magisk domain at block-write enforcement, including direct elevation without exec",
        "Retain sticky exec provenance; skip domain checks for ordinary non-block/read-only permissions"
      ],
      "generated_tool_source": {
        "path": "common/security/selinux/genheaders.c",
        "sha256": "6efe0d819e4ce85da20c705bbd1e292310dd56bb0f2457541f80edb5262cd87a"
      }
    },
    "unicode_basename_guard": {
      "repository": "https://github.com/WildKernels/kernel_patches",
      "revision": "4d4dd02faacccb61dffaf1b0b3a1b87e2d71c52c",
      "upstream_reference": "common/unicode_bypass_fix_6.1+.patch",
      "license": "GPL-2.0-only",
      "adaptation": "Reject creation of casefolded basenames normalizing to empty/dot/dotdot through Ext4/F2FS add-entry paths; preserve existing lookup/normalization/hash semantics",
      "rejected_reference_reason": "Global patch emitted default-ignorable bytes while utf8nlen still counted them as zero, changing hashes and breaking normalization length contract"
    },
    "usb_dvd": {
      "repository": "https://github.com/ravindu644/USB-Arsenal",
      "revision": "533a7f47746f14e1fdece6c5fe3058921eaf787a",
      "upstream_patch": "kernel-patches/6.12/0001-pikvm-msd-dvd-support.patch",
      "license": "GPL-2.0-only",
      "configuration": [
        "CONFIG_USB_CONFIGFS=y",
        "CONFIG_USB_CONFIGFS_MASS_STORAGE=y",
        "CONFIG_USB_CONFIGFS_F_HID=y",
        "CONFIG_USB_CONFIGFS_NCM=y"
      ],
      "already_in_6_18": [
        "HID writable interval",
        "HID allocation-time locking/list initialization",
        "HID cdev lifetime fixes"
      ]
    },
    "performance": {
      "repository": "https://github.com/WildKernels/kernel_patches",
      "revision": "4d4dd02faacccb61dffaf1b0b3a1b87e2d71c52c",
      "license": "GPL-2.0-only",
      "gate": "CONFIG_ONYX_PERFORMANCE",
      "default": false,
      "tunings": [
        {
          "source": "file_struct_8bytes_align.patch",
          "change": "Minimum struct file alignment 8 instead of4",
          "gate": "CONFIG_ONYX_PERFORMANCE",
          "abi": "Real ARM64 Clang/GENDWARF probes retain existing shared CRCs"
        },
        {
          "source": "reduce_cache_pressure.patch",
          "change": "vfs_cache_pressure default100 to50",
          "tradeoff": "Retain more directory/inode cache"
        },
        {
          "source": "mem_opt_prefetch.patch",
          "change": "Prefetch one initial and four loop-ahead ARM64 cache lines"
        },
        {
          "source": "optimise_memcmp.patch",
          "change": "Scalar32-byte comparison loop and short-input improvements",
          "adaptation": "Remove bare FPSIMD path; generic kernel memcmp must preserve vector state"
        },
        {
          "source": "minimise_wakeup_time.patch",
          "change": "Alarmtimer hold to nearest deadline+1ms",
          "adaptation": "Clamp1..2000ms, including already-overdue negative deadlines"
        },
        {
          "source": "int_sqrt.patch",
          "change": "Fixed-high-bit integer sqrt variant",
          "adaptation": "Keep highest power-of-four for large inputs and preserve exported signature"
        },
        {
          "source": "reduce_gc_thread_sleep_time.patch",
          "change": "F2FS urgent GC sleep500ms to50ms"
        },
        {
          "source": "reduce_freeze_timeout.patch",
          "change": "Freezer default20seconds to1second",
          "adaptation": "Honor valid runtime sysfs writes for recovery"
        },
        {
          "source": "clear_page_16bytes_align.patch",
          "change": "Align ARM64 clear_page entry to16bytes"
        },
        {
          "source": "avoid_extra_s2idle_wake_attempts.patch",
          "change": "Wake s2idle only on first abort increment"
        },
        {
          "source": "disable_cache_hot_buddy.patch",
          "change": "Disable CACHE_HOT_BUDDY scheduling preference"
        },
        {
          "source": "f2fs_enlarge_min_fsync_blocks.patch",
          "change": "F2FS minimum fsync blocks8 to20"
        },
        {
          "source": "increase_ext4_default_commit_age.patch",
          "change": "Ext4 journal default commit age5seconds to30seconds",
          "tradeoff": "Larger window for unsynced metadata loss during sudden power loss"
        },
        {
          "source": "increase_sk_mem_packets.patch",
          "change": "Socket default memory packet scale256 to1024",
          "tradeoff": "Larger socket buffers use more memory"
        },
        {
          "source": "reduce_pci_pme_wakeups.patch",
          "change": "PCI PME polling interval1second to4seconds",
          "tradeoff": "Longer polling latency for devices needing this workaround"
        },
        {
          "source": "silence_irq_cpu_logspam.patch",
          "change": "IRQ affinity failure message becomes debug-ratelimited"
        },
        {
          "source": "silence_system_logspam.patch",
          "change": "Suppress devkmsg messages containing healthd/logd/dashd",
          "tradeoff": "Less userspace diagnostic logging"
        }
      ],
      "omitted": {
        "optimized_mem_operations.patch": "ARM64 already uses native assembly mem functions",
        "f2fs_reduce_congestion.patch": "DEFAULT_IO_TIMEOUT and the old congestion wait were removed from Linux 6.18",
        "add_timeout_wakelocks_globally.patch": "No-timeout wake locks must remain held until caller releases them; forced expiry violates the API"
      }
    }
  },
