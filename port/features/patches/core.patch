+# SPDX-License-Identifier: GPL-2.0-only
+menu "Onyx kernel profiles"
+config ONYX_FEATURES
+	bool "Onyx shared feature support"
+	default y
+	select KEYS
+
+config ONYX_PERFORMANCE
+	bool "Onyx performance tuning profile"
