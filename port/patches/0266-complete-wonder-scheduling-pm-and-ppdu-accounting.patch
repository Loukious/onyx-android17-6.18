+	iter->this_arg_index = IEEE80211_RADIOTAP_HE;
+	iter->this_arg_size = sizeof(struct ieee80211_radiotap_he);
+	iter->_arg = iter->this_arg + iter->this_arg_size;
+	iter->_bitmap_shifter >>= 1;
+	iter->_arg_index++;
+	return 0;
