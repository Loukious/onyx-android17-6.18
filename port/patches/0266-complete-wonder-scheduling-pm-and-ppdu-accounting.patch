+			wma_injection_channel_change_end();
+			if (ret)
+				goto failed;
+			status = cdp_refresh_monitor_mode(cds_get_context(QDF_MODULE_ID_SOC),
+					 OL_TXRX_PDEV_ID, adapter->deflink->vdev_id);
+			if (QDF_IS_STATUS_ERROR(status)) {
+				ret = qdf_status_to_os_return(status);
+				goto failed;
+			}
