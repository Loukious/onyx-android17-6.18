+	ret = hdd_wonder_peer_prepare(session->peer, params->freq, generation);
+	if (ret)
+		goto failed;
+	if (session->sched) {
+		ret = hdd_wonder_bind_clock(session, false);
+		if (ret)
+			goto failed;
+	}
+	session->channel = *params;
+	return 0;
+failed:
+	WRITE_ONCE(session->failed, true);
+	netif_tx_disable(adapter->dev);
+	return ret;
+}
