+		ret = hdd_sta_mon_get_channel(adapter, &shared);
+		if (ret)
+			return ret;
+		generation = wlan_mlme_sta_mon_epoch(hdd_ctx->psoc);
+		/* The live shared width can be wider than Wonder's requested rate. */
+		*completed_ns = ktime_get_ns();
