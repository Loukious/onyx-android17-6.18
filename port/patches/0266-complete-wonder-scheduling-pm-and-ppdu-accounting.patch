+{
+	struct dp_mon_pdev *mon_pdev = pdev->monitor_pdev;
+	QDF_STATUS status;
 
+	spin_lock_bh(&dp_wonder_airtime_config_lock);
+	if (mon_pdev->wonder_airtime_enabled) {
+		if (mon_pdev->wonder_airtime_vdev_id != monitor_id) {
+			status = QDF_STATUS_E_BUSY;
+			goto unlock;
+		}
+		if (enabled) {
