+	    WMITLV_TAG_STRUC_wmi_offchan_data_tx_compl_event_fixed_param ||
+	    WMITLV_GET_TLVLEN(evt->tlv_header) !=
+	    WMITLV_GET_STRUCT_TLVLEN(wmi_offchan_data_tx_compl_event_fixed_param))
+		return QDF_STATUS_E_INVAL;
