+
+bool wlan_injection_wonder_rx_begin(void *arg, u8 monitor_id, u64 generation,
+		u32 measured_frequency, struct cdp_wonder_rx_lease *lease)
+{
+	struct wlan_mlme_sta_mon_snapshot snapshot;
