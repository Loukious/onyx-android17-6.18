+	owner = wlan_mlme_sta_mon_ap_is_owner(hdd_ctx->psoc, link_info->vdev_id);
+	wlan_mlme_sta_mon_update_begin(hdd_ctx->psoc);
+	WRITE_ONCE(sap->sta_mon_transition, true);
