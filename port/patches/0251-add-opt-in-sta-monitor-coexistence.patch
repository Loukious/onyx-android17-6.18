+		ctrl->state == WLAN_STA_MON_ARMING &&
+		ctrl->handoff_phase == WLAN_STA_MON_HANDOFF_RESTART &&
+		ctrl->snapshot.exclusive && ctrl->snapshot.mon_vdev_id == monitor_id;
+	spin_unlock_irqrestore(&sta_mon_lock, flags);
+	return ok;
+}
